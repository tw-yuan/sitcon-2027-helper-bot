# =============================================================================
# 小石（SITCON 2027 Bot）環境變數範本
# 複製為 .env 後填入。啟動時 pydantic-settings 會驗證，缺必要變數即 fail-fast。
# 所有 secret 僅經此檔／掛載檔注入，絕不進 repo、日誌、LLM context（NFR-3）。
# =============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                # BotFather 取得；務必先 /setprivacy → Disable（TRIG-2）
TELEGRAM_ADMIN_ID=                 # 管理員數字 user ID（AUTH-1），非 username
BOT_TRIGGER_NAME=小石              # TRIG-1(c) 觸發前綴

# --- LLM ---
LLM_PROVIDER=anthropic             # anthropic | openai_compat
LLM_MODEL=claude-sonnet-4-6        # 依 provider 的模型字串；OpenRouter 例：anthropic/claude-sonnet-4.6
LLM_API_KEY=
LLM_BASE_URL=                      # 自訂 gateway；openai_compat 要填到 API 根（SDK 會接 /chat/completions，通常需含 /v1，例：https://ai.kot.gg/v1）。留空用官方
LLM_AUTH_BEARER=false              # 僅 anthropic：true＝以 Authorization: Bearer 送憑證（對應 ANTHROPIC_AUTH_TOKEN 形式的 gateway）；false＝官方 x-api-key
LLM_THINKING=high                  # off | low | medium | high | xhigh | max（對映到 adaptive thinking 的 effort；部分 provider 未必支援 max）
LLM_MAX_TOOL_ITERATIONS=8
LLM_SERVICE_TIER=                  # 僅 openai_compat；留空＝不帶。Codex 的 fast mode 即 fast；官方 API 另有 priority／flex。不支援時 provider 回 400

# --- 併發 ---
MAX_CONCURRENT_UPDATES=32          # 同時處理的 update 上限（>1 才會並行；1 = 舊行為，逐則處理）
MAX_CONCURRENT_AGENT_TURNS=8       # 同時進行的 agent 回合上限（跨群共用）
SERIALIZE_PER_CHAT=true            # true=同一對話（群＋topic）依序回，順序不亂；false=同群也並行（SPEC EC-16）

# --- GitLab ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=                      # service account PAT，scope=api；帳號需為專案成員（≥Reporter）
GITLAB_PROJECT=sitcon-tw/2027      # 本系統唯一操作的專案

# --- Google（service account）---
GOOGLE_SA_JSON_PATH=/run/secrets/google-sa.json   # service account 金鑰（compose 掛載）
DRIVE_SHARED_DRIVE_ID=0AIx9UW7aBiDgUk9PVA          # 保留參考；實際查詢用 corpora=allDrives + 下列資料夾 ID
# DR-1 搜尋範圍：名稱=資料夾ID（service account 只要被分享這兩個資料夾即可，不必是共用硬碟成員）
DRIVE_SCOPE_FOLDERS=SITCON 2027=1pigQFmO-v5xWjvhTWJrXQWcWGqTfPX_F,SITCON 2026=1oXcggPh2qxv0Do-g-ws6Nze1USoptA4T
ROSTER_SHEET_ID=1BiK-zMplJqSakQNfdQeDkwe2BMk21ngbm0xGEv8L5e4
ROSTER_SHEET_GID=1822407485                         # RO-1：以 gid 解析分頁名再讀值
MILESTONE_SHEET_ID=1esryzLBpnE51NIUU4-prwG0RrnG3W4eYQJ6FZSigFPQ   # NT-1 籌備時程表（須分享給 service account，檢視者即可）
MILESTONE_SHEET_GID=0                               # 「工作表1」；以 gid 解析分頁名再讀值
# Calendar（DWD）：留空＝停用。需在 Workspace 管理後台對 service account 的 client ID
# 授權 https://www.googleapis.com/auth/calendar scope（安全性 → API 控制 → 網域全域委派）
GOOGLE_DWD_SUBJECT=                                 # 冒用對象 email（例：me@yuan-tw.net）
CALENDAR_ID=primary                                 # 操作冒用對象的哪本行事曆（可填共用日曆 ID）
CALENDAR_SEND_UPDATES=all                           # 活動異動通知信：all／externalOnly／none（none=不寄，對方日曆仍看得到）

# --- HackMD ---
HACKMD_TOKEN=                      # team 成員個人 API token（無 team token）
HACKMD_TEAM_PATH=                  # team path（api.hackmd.io/v1/teams/<path>/...）
HACKMD_YEAR_FOLDER=SITCON 2027     # 建立筆記的年度根資料夾（同一 team 有多年度）
HACKMD_SEARCH_YEAR_FOLDERS=SITCON 2027,SITCON 2026   # 搜尋筆記的範圍年度（逗號分隔）
HACKMD_MEETING_FOLDER=會議文件      # 大籌／站立會議記錄放：<年度根>/會議文件
HACKMD_TEAM_MEETING_SUBFOLDER=會議文件   # 組會記錄放：<年度根>/<組別>/會議文件（子夾自動補建）
HACKMD_DEFAULT_READ_PERM=signed_in      # HM-7（read/write 值域：owner/signed_in/guest）
HACKMD_DEFAULT_WRITE_PERM=signed_in

# --- 里程碑預告（NT-*）---
MILESTONE_NOTIFY_ENABLED=true       # false＝完全不啟動排程，/notify_* 一律回「未啟用」
MILESTONE_NOTIFY_HOUR=23            # Asia/Taipei；每天此時預告「隔天」里程碑＋過期卡片提醒
MILESTONE_NOTIFY_MINUTE=0
MILESTONE_NOTIFY_CATCHUP_MINUTES=60    # 錯過到點（如重啟中）時的補送視窗；逾時跳過該日
MILESTONE_ALWAYS_TEAMS=全體,重要日期    # 不論訂閱哪幾組都會收到的組別
MILESTONE_NOTIFY_WHEN_EMPTY=false   # true＝隔天沒事也送一則「沒有里程碑事項」

# --- 快取 TTL（秒）---
CACHE_TTL_LABELS=600
CACHE_TTL_HACKMD=600
CACHE_TTL_DRIVE_TREE=1800
CACHE_TTL_ROSTER=3600
CACHE_TTL_MILESTONES=3600

# --- 其他 ---
TEAM_CHARTER_PATH=role.md         # 職掌文件（RO-8，供 LLM 判斷組別）；缺檔仍可運作，/reload 重載
KNOWLEDGE_PATH=config/knowledge.md  # 背景知識（會議室代碼等內部常識）；缺檔仍可運作，/reload 重載
TZ=Asia/Taipei
CONTEXT_TTL_SECONDS=1800
CONTEXT_MAX_TURNS=10
LOG_LEVEL=INFO
DB_PATH=/data/sitcon_bot.sqlite3
